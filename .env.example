# ═══════════════════════════════════════════════════════════════════
# Yiriba SaaS — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_NAME=Yiriba
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # false en production
APP_SECRET_KEY=change-me-32-char-minimum-random-string
APP_PORT=5050

# ── Base de données ───────────────────────────────────────────────
# SQLite (développement) — fichier local, pratique en local uniquement.
DATABASE_URL=sqlite+aiosqlite:///./yiriba.db

# PostgreSQL (production) — le driver est ajouté automatiquement, donc tu
# peux coller telle quelle l'URL fournie par l'hébergeur (Render/Neon/...).
# DATABASE_URL=postgresql://user:password@host:5432/yiriba
# DATABASE_ENCRYPTION_KEY=aes256-key-32-chars-minimum

# ⚠️ Production : la base DOIT être externe au conteneur (PostgreSQL géré ou
# disque persistant). Sinon chaque redéploiement efface les données.

# ── JWT / Authentification ────────────────────────────────────────
JWT_SECRET_KEY=change-me-32-char-minimum-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute

# ── Fichiers ──────────────────────────────────────────────────────
# En production, pointe UPLOAD_DIR vers un dossier PERSISTANT (volume).
# Sur Render : UPLOAD_DIR=/app/data/uploads (disque persistant).
# Sur un VPS/mutualisé : UPLOAD_DIR=/var/yiriba/uploads (hors du code).
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Sauvegarde ────────────────────────────────────────────────────
# python scripts/backup.py --dest ./backups --keep 7
# À planifier quotidiennement (cron / tâche planifiée).

# ── Mobile Money (PayDunya) ──────────────────────────────────────
# PAYDUNYA_PARTNER_TOKEN=your-token
# PAYDUNYA_APP_TOKEN=your-app-token
# PAYDUNYA_MASTER_KEY=your-master-key
# PAYDUNYA_MODE=sandbox                        # sandbox | live

# ── SMS (untel.com ou équivalent) ────────────────────────────────
# SMS_API_URL=https://api.untel.com/sms
# SMS_API_KEY=your-sms-api-key
# SMS_SENDER=YIRIBA

# ── Google OAuth ─────────────────────────────────────────────────
# Créez un projet sur https://console.cloud.google.com
# Activez Google People API, puis créez des identifiants OAuth 2.0
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5050/api/auth/google/callback

# ── Plateforme éditeur ────────────────────────────────────────────
# Emails autorisés à gérer le catalogue de forfaits (admin YIRIBA plateforme).
# Séparés par des virgules. Vide = personne.
PLATFORM_ADMIN_EMAILS=

# ── Inscription (confirmation email + anti-bot) ───────────────────
# REQUIRE_EMAIL_CONFIRMATION=true  => compte 'pending' jusqu'au clic sur le lien reçu par email
# REQUIRE_EMAIL_CONFIRMATION=false => compte actif immédiatement (défaut)
REQUIRE_EMAIL_CONFIRMATION=false
CONFIRMATION_TOKEN_TTL_HOURS=24

# Email — provider: "resend" (API REST) ou "smtp". Si aucun n'est configuré,
# les emails sont loggés en console (dev).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=YIRIBA <no-reply@yiriba.app>          # une fois le domaine vérifié
# RESEND_FROM=YIRIBA <onboarding@resend.dev>        # mode test (envoi vers ton propre email uniquement)

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=no-reply@votre-domaine.com
# SMTP_PASSWORD=secret
# SMTP_FROM=YIRIBA <no-reply@yiriba.app>
# SMTP_USE_TLS=true

# Captcha Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...

# ── CORS ──────────────────────────────────────────────────────────
# Séparés par des virgules en production
# CORS_ORIGINS=https://yiriba.app,https://admin.yiriba.app
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
